# GPT Trial Protocol 配置示例
#
# 复制为 .env 后按需修改：
#   cp .env.example .env
#
# 注意：脚本不会自动读取 .env；使用 run_gpt_trial.sh 时会加载。

# ChatGPT/Auth/Sentinel 使用的代理。建议使用稳定 JP 出口。
GPT_TRIAL_PROXY=http://127.0.0.1:7897

# 邮箱类型：auto / icloud / frimail
GPT_TRIAL_EMAIL_TYPE=frimail

# 接码接口类型：auto / agiunx / frimail
GPT_TRIAL_EMAIL_CODE_PROVIDER=auto

# 接码接口主域名；通常留空即可。
# agiunx 默认：https://agiunx.com
# frimail 默认：https://api.cudaflowers.edu.kg
GPT_TRIAL_EMAIL_CODE_BASE_URL=

# Checkout 默认按 US/USD 生成。
GPT_TRIAL_CHECKOUT_COUNTRY=US
GPT_TRIAL_CHECKOUT_CURRENCY=USD

# 超时配置。
GPT_TRIAL_TIMEOUT=30
GPT_TRIAL_CODE_TIMEOUT=90
GPT_TRIAL_PLUS_STATUS_TIMEOUT=30
GPT_TRIAL_PLUS_STATUS_INTERVAL=3

# HTTP backend：curl_cffi / httpx
GPT_TRIAL_BACKEND=curl_cffi

# 输出与 trace。
GPT_TRIAL_OUT=runtime/results.jsonl
GPT_TRIAL_TRACE_DIR=runtime/traces

# 自动生成邮箱前缀默认规则：
# lu + HHMMSS + 4位小写字母数字
GPT_TRIAL_GENERATED_EMAIL_PREFIX=lu
