# Runtime secrets are intentionally not committed.
#
# Copy this file to .env on the server and fill the values:
#   cp ruyipage/.env.example ruyipage/.env

# CAPTCHA solving, used when PayPal/Stripe challenge is triggered.
APIKEY_2CAPTCHA=

# Recommended on a plain Linux server:
# - use an explicit upstream proxy
# - set chain via direct, unless your server also needs a parent proxy
RUYI_PROXY_CHAIN_UPSTREAM=
RUYI_PROXY_CHAIN_VIA=direct

# Optional direct browser proxy instead of chain mode.
# RUYI_PROXY=direct

# Optional browser path override. Default points to this repo's extracted
# firefox-fingerprintBrowser/browser/firefox/firefox.
# RUYI_FIREFOX_PATH=
