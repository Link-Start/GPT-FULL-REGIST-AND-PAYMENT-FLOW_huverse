# GPT trial protocol + ruyi PayPal payment full-flow example.
#
# Copy to full_flow.env if you want wrapper defaults:
#   cp full_flow.env.example full_flow.env

# Protocol registration proxy. The protocol project docs recommend a stable
# ChatGPT/Auth-capable local proxy.
# To run protocol registration without proxy, set:
#   GPT_TRIAL_PROXY=direct
# or pass:
#   --no-protocol-proxy
GPT_TRIAL_PROXY=http://127.0.0.1:7897

# Optional payment defaults. The payment script also loads ruyipage/.env for
# 2Captcha/proxy-chain settings.
# ADDRESS_JSON=/path/to/GPT-FULL-REGIST-AND-PAYMENT-FLOW/ruyipage/address.example.json
# SMS_LINE=+1xxxxxxxxxx|https://sms-provider.example/api
# Payment remains direct by default. Enable this only as a one-time fallback
# when DataDome returns t=bv on the direct payment attempt.
# Set PAYMENT_PROXY_ENABLED=1 to start payment through PAYMENT_PROXY. If
# PAYMENT_PROXY is empty, the flow reuses PAYMENT_TEMP_PROXY as the main exit.
# PAYMENT_PROXY_ENABLED=0
# PAYMENT_PROXY=proxy-host:port:user:pass(http)
# PAYMENT_PROXY_USE_BRIDGE=1
# PAYMENT_TEMP_PROXY_ENABLED=0
# PAYMENT_TEMP_PROXY=proxy-host:port:user:pass(socks)
# Limit concurrent ruyi/Firefox payment browsers during queue runs. Protocol
# workers remain concurrent; Firefox startup is separately locked to avoid
# headless BrowserConnectError. Set 0 only for explicit stress testing.
# FULL_FLOW_PAYMENT_BROWSER_SLOTS=2
# FULL_FLOW_PAYMENT_SLOT_WAIT_INTERVAL=1

# Optional SQLite pool/full-flow web UI defaults.
# FULL_FLOW_POOL_DB=/path/to/GPT-FULL-REGIST-AND-PAYMENT-FLOW/accfile/pool/full_flow.sqlite3
# FULL_FLOW_POOL_MAX_EMAIL_RETRIES=3
# FULL_FLOW_WEB_HOST=0.0.0.0
# FULL_FLOW_WEB_PORT=8765
